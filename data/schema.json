{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arabic AI Atlas entry",
  "type": "object",
  "required": ["id", "name", "type", "country", "org", "license", "modality", "tasks", "links"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "type": {"enum": ["llm", "asr", "tts", "ocr", "embedding", "dataset", "tool", "benchmark", "org", "agent-skill"]},
    "country": {"enum": ["SA", "AE", "EG", "QA", "MA", "JO", "TN", "LB", "KW", "OM", "BH", "DZ", "LY", "SD", "IQ", "SY", "YE", "PS", "MR", "SO", "DJ", "KM", "INTL"]},
    "org": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "modality": {"enum": ["text", "speech", "vision", "multimodal", "none"]},
    "size": {"type": "string"},
    "year": {"type": "integer"},
    "on_device": {"type": "boolean"},
    "dialects": {
      "type": "array",
      "items": {"enum": ["msa", "egy", "gulf", "lev", "magh", "iraqi", "sudanese", "yemeni", "classical", "mixed"]}
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "links": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "hf": {"type": "string", "pattern": "^https?://"},
        "github": {"type": "string", "pattern": "^https?://"},
        "paper": {"type": "string", "pattern": "^https?://"},
        "website": {"type": "string", "pattern": "^https?://"}
      }
    },
    "notes": {"type": "string", "maxLength": 160},
    "_file": {"type": "string"}
  }
}
